server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # /api/* -> бэкенд внутри docker-сети (имя сервиса подставляется из env)
    location /api/ {
        proxy_pass http://${API_HOST}:${API_PORT}/;
        proxy_connect_timeout 10s;
        proxy_read_timeout    600s;   # генерация квеста долгая
        proxy_send_timeout    600s;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}